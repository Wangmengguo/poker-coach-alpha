# Poker Coach Alpha - Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# AI Provider Configuration
# Heuristic-only (no external calls): set AI_PROVIDER=dummy
# Enable LLM features: set AI_PROVIDER=openai and fill OPENAI_API_KEY
AI_PROVIDER=dummy

# OpenAI API Key (required if AI_PROVIDER=openai)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: Custom API base URL (OpenAI-compatible gateways)
# OpenRouter: https://openrouter.ai/api/v1
# GLM (Zhipu): https://open.bigmodel.cn/api/paas/v4
# Use model IDs that exist on YOUR gateway (admin page: Fetch model list).
OPENAI_API_BASE=

# Optional: Default frontend-facing LLM tier
# Available: smart, balanced, fast
AI_MODEL_TIER=balanced

# Optional: Tier -> model ID mappings (must match your gateway; not placeholder names)
# Example GLM setup (replace glm-4.x with IDs from your bigmodel.cn console):
# AI_SMART_MODEL=glm-4.x
# AI_BALANCED_MODEL=glm-4.x
# AI_FAST_MODEL=glm-4-flash
AI_SMART_MODEL=
AI_BALANCED_MODEL=
AI_FAST_MODEL=

# Optional: LLM admin/local development controls
# Use ADMIN_TOKEN for deployed admin access. Enable local bypasses only for local dev.
ADMIN_TOKEN=
LOCAL_ADMIN_BYPASS=0
LOCAL_INVITE_BYPASS=0

# Reverse-proxy client IP trust (uvicorn --proxy-headers).
# Default * is safe when POKER_BIND_ADDR=127.0.0.1 (Nginx-only access).
# If you expose 8010 publicly, restrict to your proxy IP (e.g. 127.0.0.1).
FORWARDED_ALLOW_IPS=*

# Optional: Enable debug logging for AI Coach
AI_COACH_DEBUG=0

# Optional: Docker-only port bind address
# Default is 127.0.0.1 (recommended when using Nginx). Set to 0.0.0.0 only if you
# intentionally want to expose port 8010 to the public internet.
POKER_BIND_ADDR=127.0.0.1
